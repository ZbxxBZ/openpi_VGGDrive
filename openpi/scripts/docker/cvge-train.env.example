# Host paths as seen by the Docker daemon. In the swf-dev DooD setup,
# /root inside swf-dev is backed by /data/swf/home on the Docker host.
ZBX_ROOT_HOST=/data/swf/home/zbx
OPENPI_SOURCE=/data/swf/home/zbx/openpi_VGGDrive/openpi
CHECKPOINTS_DIR=/data/swf/home/zbx/checkpoints

# GPU 0 is in use by another workload; expose only GPU 1 to zbx containers.
GPU_DEVICE_ID=1
NPROC_PER_NODE=1

# Container resource limits and shared-memory allocation.
CPU_LIMIT=32
MEM_LIMIT=128g
SHM_SIZE=32gb

# Shared training settings. Global batch size must be divisible by NPROC_PER_NODE.
BATCH_SIZE=1
NUM_WORKERS=0
IMAGE_SIZE=224
SAVE_INTERVAL=1000
KEEP_PERIOD=5000

# Stage 1 trains CVGE only. Its selected checkpoint initializes Stage 2.
STAGE1_EXP_NAME=robotwin_stage1
STAGE1_STEPS=5000
STAGE1_CHECKPOINT_STEP=5000
STAGE1_RESUME=0
STAGE1_OVERWRITE=0

# Stage 2 jointly fine-tunes the pi0.5 backbone and CVGE with a fresh optimizer; VGGT stays frozen.
STAGE2_EXP_NAME=robotwin_stage2
STAGE2_STEPS=20000
STAGE2_RESUME=0
STAGE2_OVERWRITE=0

# Set both values to enable online logging. Leave WANDB_ENABLED=0 for offline training.
WANDB_ENABLED=0
WANDB_API_KEY=

NCCL_DEBUG=WARN
TRAIN_IMAGE=zbx-openpi:cu128
